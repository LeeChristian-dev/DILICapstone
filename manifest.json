{
  "manifest_version": 3,
  "name": "DILI",
  "version": "0.1.0",
  "description": "Detects illegal link injections in edited Facebook links and malicious redirects.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["styles/post-risk-label.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
